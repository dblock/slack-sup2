<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% indexable_page = !%w[/subscribe /subscribe.html /update_cc /update_cc.html /gcal /gcal.html].include?(request.path) %>
<% if indexable_page %>
<link rel="canonical" href="<%= "#{SlackRubyBotServer::Service.url}#{request.path}" %>">
<meta property="og:site_name" content="S'Up for Slack Teams">
<meta property="og:type" content="website">
<meta property="og:url" content="<%= "#{SlackRubyBotServer::Service.url}#{request.path}" %>">
<meta property="og:image" content="<%= h "#{SlackRubyBotServer::Service.url}#{asset_path('/img/icon.png')}" %>">
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@playplayio">
<% end %>
<link rel="stylesheet" href="<%= h asset_path('/styles.css') %>">
<link rel="apple-touch-icon" sizes="57x57" href="<%= h asset_path('/img/favicons/apple-icon-57x57.png') %>">
<link rel="apple-touch-icon" sizes="60x60" href="<%= h asset_path('/img/favicons/apple-icon-60x60.png') %>">
<link rel="apple-touch-icon" sizes="72x72" href="<%= h asset_path('/img/favicons/apple-icon-72x72.png') %>">
<link rel="apple-touch-icon" sizes="76x76" href="<%= h asset_path('/img/favicons/apple-icon-76x76.png') %>">
<link rel="apple-touch-icon" sizes="114x114" href="<%= h asset_path('/img/favicons/apple-icon-114x114.png') %>">
<link rel="apple-touch-icon" sizes="120x120" href="<%= h asset_path('/img/favicons/apple-icon-120x120.png') %>">
<link rel="apple-touch-icon" sizes="144x144" href="<%= h asset_path('/img/favicons/apple-icon-144x144.png') %>">
<link rel="apple-touch-icon" sizes="152x152" href="<%= h asset_path('/img/favicons/apple-icon-152x152.png') %>">
<link rel="apple-touch-icon" sizes="180x180" href="<%= h asset_path('/img/favicons/apple-icon-180x180.png') %>">
<link rel="icon" type="image/png" sizes="192x192" href="<%= h asset_path('/img/favicons/android-icon-192x192.png') %>">
<link rel="icon" type="image/png" sizes="32x32" href="<%= h asset_path('/img/favicons/favicon-32x32.png') %>">
<link rel="icon" type="image/png" sizes="96x96" href="<%= h asset_path('/img/favicons/favicon-96x96.png') %>">
<link rel="icon" type="image/png" sizes="16x16" href="<%= h asset_path('/img/favicons/favicon-16x16.png') %>">
<link rel="manifest" href="<%= h asset_path('/img/favicons/manifest.json') %>">
<meta name="msapplication-TileColor" content="#4a154b">
<meta name="msapplication-TileImage" content="<%= h asset_path('/img/favicons/ms-icon-144x144.png') %>">
<meta name="theme-color" content="#4a154b">
<meta name="slack-app-id" content="<%= ENV["SLACK_APP_ID"] %>">
